{
  "manifest_version": 3,
  "name": "Walmart Receipt Parser",
  "version": "1.1",
  "description": "Scrapes Walmart receipt information from a specific receipt and pushes it to Google Sheets",
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "Scrape Receipt",
    "default_icon": "icons/icon.png"
  },
  "permissions": [
    "activeTab",
    "declarativeContent",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://*.googleapis.com/*",
    "https://script.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": { 
    "page": "options.html"
  }
}